# ---- App (bundled into the build: PUBLIC values only) ------------------------------------------
# Copy to .env.local (git-ignored). NEVER put a service_role key or any AI key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ---- Edge Function secrets (server only: `supabase secrets set NAME=value`, never in the app) ---
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase itself.

# OpenCode Zen. Take the base URL and the authentication scheme from the provider's OFFICIAL docs
# (https://opencode.ai/docs/zen/) before setting them. The gateway has no default endpoint on purpose.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=

# Optional limits (defaults in parentheses)
AI_DAILY_REQUEST_LIMIT=      # per user per rolling 24 h (40)
AI_MINUTE_LIMIT=             # per user per minute (6)
AI_MAX_OUTPUT_TOKENS=        # hard cap, also bounded by each task route (700)
AI_REQUEST_TIMEOUT_MS=       # per provider call (20000)

# Which models are used is NOT configured here: it lives in the database
# (ai_model_registry / ai_task_routing) and is changed through the admin API without an app update.
# See docs/AI_MODEL_REGISTRY.md.
