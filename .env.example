# Copy to .env.local (git-ignored) for development. EXPO_PUBLIC_* values are bundled into the app:
# put only PUBLIC values here. NEVER put the Supabase service_role key or any AI key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-side only (set with `supabase secrets set`, never in the app):
# ANTHROPIC_API_KEY=...
# AI_MODEL=claude-haiku-5-5
# AI_DAILY_LIMIT=60
# AI_MINUTE_LIMIT=6
